# --- Auth (required in production) ---
# Generate with: openssl rand -base64 32   (or any long random string)
AUTH_SECRET=

# Google OAuth app credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URIs: https://<your-domain>/api/auth/callback/google  (sign-in)
#                      AND https://<your-domain>/api/gmail/callback         (Gmail scan consent)
# (plus the http://localhost:3000/... versions of both for dev)
# Enable the "Gmail API" for the project; add scope gmail.readonly on the consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only this Google account may sign in
ALLOWED_EMAIL=abdullokhan3@gmail.com

# --- Database ---
# MongoDB Atlas connection string. If empty, the app falls back to a local JSON file (data/dev-db.json) — dev only.
MONGODB_URI=

# --- Gmail scan cron (Phase 2) ---
# Vercel Cron calls GET /api/scan with "Authorization: Bearer $CRON_SECRET".
# Set any long random string; Vercel injects it into cron requests automatically.
CRON_SECRET=

# How far back the very first scan looks (days). Later scans resume from the watermark. Default 30.
SCAN_INITIAL_DAYS=

# --- Development ---
# Set to "true" to skip Google sign-in locally (NEVER set in production)
DEV_BYPASS_AUTH=
